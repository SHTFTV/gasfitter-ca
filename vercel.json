{
  "redirects": [
    { "source": "/app", "destination": "/", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/gas-lines-vancouver", "destination": "/gas-line-installation-guide-lower-mainland/", "permanent": true },
    { "source": "/locations", "destination": "/#locations", "permanent": true },
    { "source": "/management-system", "destination": "/", "permanent": true },
    { "source": "/services", "destination": "/#services", "permanent": true },
    { "source": "/testimonials", "destination": "/", "permanent": true },
    { "source": "/whychooseus", "destination": "/", "permanent": true }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }]
}
